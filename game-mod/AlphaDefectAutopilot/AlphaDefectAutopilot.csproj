<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Slay the Spire 2 の MOD（ゲーム側）。ビルドはインストール済みのゲームのアセンブリを参照する。
    ゲームの版に合わせて切り替える:

      dotnet build -c Release -p:Sts2GameDir="$HOME/.local/share/sls2/game/v0.111.1"

    できた AlphaDefectAutopilot.dll と AlphaDefectAutopilot.json を
    <ゲーム>/mods/AlphaDefectAutopilot/ に置くと、ゲームが起動時に読み込む
    （読み込みの仕組みは MegaCrit.Sts2.Core.Modding.ModManager）。
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AlphaDefectAutopilot</AssemblyName>
    <RootNamespace>AlphaDefectAutopilot</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- ゲームのアセンブリの場所（local setup が用意するキャッシュ） -->
    <Sts2GameDir Condition="'$(Sts2GameDir)' == ''">$(HOME)/.local/share/sls2/game/v0.111.1</Sts2GameDir>
    <!-- 観測エンコーダを借りるコードツリー（ゲームの版に合わせる） -->
    <ObsTree Condition="'$(ObsTree)' == ''">$(MSBuildThisFileDirectory)../../game-v0.111.0/engine/Sts2Headless</ObsTree>
  </PropertyGroup>

  <ItemGroup>
    <!-- 実行時はゲームが読み込み済みのものを共有する（コピーしない） -->
    <Reference Include="sts2">
      <HintPath>$(Sts2GameDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2GameDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2GameDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 無頭エンジンの観測エンコーダを共有する（種明かし: 同じ観測フレームを作るため）。
       engine/Directory.Build.targets が Sts2Bridge 向けにやっているのと同じ組み方。 -->
  <ItemGroup>
    <Compile Include="$(ObsTree)/Engine/Obs/**/*.cs" LinkBase="Headless/Obs" />
    <Compile Include="$(ObsTree)/Engine/Observation.cs" Link="Headless/Observation.cs" />
    <Compile Include="$(ObsTree)/Engine/Compat/**/*.cs" LinkBase="Headless/Compat" />
    <Compile Include="$(ObsTree)/Engine/Decision.cs" Link="Headless/Decision.cs" />
    <Compile Include="$(ObsTree)/AgentCardSelector.cs" Link="Headless/AgentCardSelector.cs" />
    <Compile Include="$(ObsTree)/Engine/Vocab.cs" Link="Headless/Vocab.cs" />
    <Compile Include="$(ObsTree)/Engine/RewardsFlow.cs" Link="Headless/RewardsFlow.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="AlphaDefectAutopilot.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 語彙（観測の数値 → 内容の ID）。エンコーダが読む -->
    <Content Include="$(ObsTree)/../catalog/vocab.txt" Link="vocab.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
